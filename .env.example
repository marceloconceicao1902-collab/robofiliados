# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# ============================================
# BANCO DE DADOS (SQLite via Prisma)
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# REDIS (BullMQ - Queue System)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SHOPEE AFILIADOS
# ============================================
# Tag de afiliado Shopee (ex: seu_usuario-123)
SHOPEE_AFFILIATE_TAG=seu_usuario-123
# App ID da Shopee Affiliate API
SHOPEE_APP_ID=
# App Secret da Shopee Affiliate API
SHOPEE_APP_SECRET=
# Sandbox (true/false)
SHOPEE_SANDBOX=true

# ============================================
# MERCADO LIVRE AFILIADOS
# ============================================
# Tag de afiliado Mercado Livre (parâmetro mbtc)
ML_AFFILIATE_TAG=SEU_CODIGO_MBTC
# Client ID Mercado Livre Developers
ML_CLIENT_ID=
# Client Secret Mercado Livre Developers
ML_CLIENT_SECRET=
# Access Token (obtido via OAuth)
ML_ACCESS_TOKEN=
# Sandbox (true/false)
ML_SANDBOX=true

# ============================================
# WHATSAPP - BINDINGS CONFIG (Baileys)
# ============================================
# Modo: baileys (local) ou evolution (API externa)
WHATSAPP_PROVIDER=baileys

# Baileys
# Pasta onde as sessões do WhatsApp serão salvas
WA_SESSION_FOLDER=./sessions
# Nome da sessão
WA_SESSION_NAME=default

# Evolution API (opcional, caso use provider=evolution)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=affiliate-bot

# ============================================
# CONFIGURAÇÕES DE ENVIO (Anti-Ban)
# ============================================
# Delay MÍNIMO entre envios para grupos diferentes (segundos)
SEND_MIN_DELAY=30
# Delay MÁXIMO entre envios para grupos diferentes (segundos)
SEND_MAX_DELAY=90
# Intervalo entre campanhas/ofertas (minutos)
SEND_CAMPAIGN_INTERVAL=60
# Máximo de mensagens por hora (anti-spam)
SEND_MAX_PER_HOUR=60
# Máximo de grupos por campanha
SEND_MAX_GROUPS_PER_CAMPAIGN=30

# ============================================
# ENCURTADOR DE LINKS
# ============================================
# tinyurl / bitly / none
SHORTENER_PROVIDER=tinyurl
# Bitly (opcional)
BITLY_TOKEN=

# ============================================
# ANTI-DUPLICIDADE
# ============================================
# Janela de tempo em HORAS para checar duplicidade
ANTI_DUPLICATE_WINDOW_HOURS=24

# ============================================
# WEBHOOKS (opcional)
# ============================================
# Webhook para notificar quando uma oferta é enviada
WEBHOOK_ON_SEND=
# Webhook para logs de erro
WEBHOOK_ON_ERROR=
