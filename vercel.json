{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "set NODE_PATH=C:\\Users\\marce\\AppData\\Local\\Temp\\affiliate-install\\node_modules&& npm run build",
  "outputDirectory": "dist",
  "installCommand": "echo 'node_modules pre-instalados via NODE_PATH fallback'",
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "trailingSlash": false
}
