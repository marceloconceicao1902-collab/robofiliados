{
  "name": "affiliate-bot-firebase-functions",
  "version": "1.0.0",
  "description": "Fastify Firebase Functions wrapper para Affiliate Promotion Bot",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "zod": "^3.24.1",
    "axios": "^1.7.9",
    "nanoid": "^3.3.8"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "firebase-functions-test": "^3.3.0",
    "@types/node": "^22.10.2"
  },
  "private": true
}
